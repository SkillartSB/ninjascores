{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/transferts.js": {
      "maxDuration": 60
    },
    "api/archive-matches.js": {
      "maxDuration": 60
    },
    "api/push-goals.js": {
      "maxDuration": 60
    },
    "api/cron-articles.mjs": {
      "maxDuration": 300
    },
    "api/transfert.mjs": {
      "maxDuration": 60
    },
    "api/prechauffe.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/push-goals/",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron-articles/",
      "schedule": "0 5 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/football/pronostics/",
      "destination": "/pronostics/",
      "permanent": true
    },
    {
      "source": "/football/pronostics",
      "destination": "/pronostics/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ninjascores.com"
        }
      ],
      "destination": "https://ninjascores.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/app.compiled.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/libs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/inline/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/data/(player-photos|teams-index|mv-history|league-ids).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/goooall.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=3600"
        }
      ]
    }
  ],
